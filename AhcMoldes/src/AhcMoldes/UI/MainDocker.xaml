<UserControl x:Class="AhcMoldes.UI.MainDocker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300" FontSize="12" FontFamily="Segoe UI"
             Unloaded="UserControl_Unloaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AhcMoldes;component/UI/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel Background="{StaticResource Bg}">

    <!-- Cabeçalho -->
    <Border DockPanel.Dock="Top" Padding="10,8,10,6">
      <DockPanel>
        <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource Accent}" Margin="0,0,8,0">
          <TextBlock Text="M" FontWeight="Bold" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TituloTxt" Text="AHC Moldes" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock x:Name="SubTxt" Text="moldes graduados para sublimação" Style="{StaticResource Hint}" Margin="0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Barra de status -->
    <Border DockPanel.Dock="Bottom" Background="#FF232325" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,6">
      <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource FgDim}" Text="Pronto."/>
    </Border>

    <Grid>
    <ContentControl x:Name="SingleHost" Visibility="Collapsed" Margin="8,2,8,4"/>
    <TabControl x:Name="Tabs" Margin="8,0,8,4" SelectionChanged="Tabs_SelectionChanged">

      <!-- ============================================================ DEFINIR -->
      <TabItem Header="Definir">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,4,2,4">

            <GroupBox Header="Definir clicando">
              <StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Informe quantas partes tem a peça, escolha o tamanho, ligue o modo e clique nas partes, uma de cada vez: M 1, M 2... Para a matriz, escolha MATRIZ." />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Partes/peça" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PartesPorPeca" Text="5" HorizontalContentAlignment="Center" FontWeight="SemiBold" FontSize="14"
                             LostFocus="PartesPorPeca_LostFocus"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Tamanho" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TamClique" SelectionChanged="TamClique_SelectionChanged" FontSize="14"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Próx. parte" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ParteClique" Text="1" HorizontalContentAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                  </StackPanel>
                </Grid>

                <Border x:Name="CliqueBanner" Margin="2,8,2,4" Padding="10,9" CornerRadius="6" Background="{StaticResource Input}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock x:Name="CliqueTitulo" Text="Modo clique desligado" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="CliqueSub" Text="Ligue para começar a nomear as partes." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>

                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="BtnClique" Content="▶  Ligar modo clique" Style="{StaticResource Primary}" Click="ModoClique_Click"/>
                  <Button Grid.Column="1" Content="Próximo tamanho ›" Click="ProximoTamanho_Click"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="2,6,2,0"
                           Text="Dica: se a parte estiver dentro de um grupo, segure Ctrl ao clicar. Errou? Clique de novo na parte certa com o número ajustado, ou use Ctrl+Z."/>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Moldes definidos">
              <StackPanel>
                <TextBlock x:Name="Resumo" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Margin="2,0,2,6"/>
                <UniformGrid Columns="2">
                  <Button Content="Atualizar / conferir" Click="VerDefinicoes_Click"/>
                  <Button Content="Remover da seleção" Click="RemoverDefinicao_Click"/>
                </UniformGrid>
              </StackPanel>
            </GroupBox>

            <Expander Header="Definir pela seleção (manual ou por área)">
              <StackPanel Margin="0,6,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Tamanho" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TamanhoDef" IsEditable="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Parte" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ParteNum" Text="1"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Apelido (opcional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="Apelido" ToolTip="Ex.: FRENTE, COSTAS, MANGA (só letras)"/>
                  </StackPanel>
                </Grid>
                <UniformGrid Columns="2">
                  <Button Content="Definir seleção" Click="DefinirTamanho_Click"/>
                  <Button Content="Definir MATRIZ" Click="DefinirMatriz_Click"/>
                </UniformGrid>
                <TextBlock Style="{StaticResource Hint}" Margin="2,8,2,2"
                           Text="Por área: selecione a mesma parte em todos os tamanhos, marque os tamanhos (do menor ao maior) e clique. O menor molde recebe o 1º tamanho marcado." />
                <ListBox x:Name="TamanhosAuto" Height="110" SelectionMode="Multiple"/>
                <Button Content="Definir por área" Click="DefinirAuto_Click"/>
              </StackPanel>
            </Expander>

            <Expander Header="Campos e gabaritos (nome, número, ID)">
              <StackPanel Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Hint}"
                           Text="Campos são textos trocados pelo nome/número de cada linha do pedido na montagem. Gabaritos são retângulos onde o texto deve caber." />
                <Button Content="Inserir campos padrão na matriz selecionada" Click="InserirCampos_Click"/>
                <UniformGrid Columns="3">
                  <Button Content="Campo NOME" Tag="NOME" Click="Marcar_Click"/>
                  <Button Content="Campo Nº" Tag="NUMERO" Click="Marcar_Click"/>
                  <Button Content="Campo ADIC." Tag="ADICIONAL" Click="Marcar_Click"/>
                </UniformGrid>
                <UniformGrid Columns="2">
                  <Button Content="Gabarito NOME" Tag="GAB_NOME" Click="Marcar_Click"/>
                  <Button Content="Gabarito Nº" Tag="GAB_NUMERO" Click="Marcar_Click"/>
                  <Button Content="Gabarito ADIC." Tag="GAB_ADICIONAL" Click="Marcar_Click"/>
                  <Button Content="Gabarito ID" Tag="GAB_ID" Click="Marcar_Click"/>
                  <Button Content="Marcar FIXO" Tag="FIXO" Click="Marcar_Click"
                          ToolTip="Arte que não muda de tamanho na graduação (escudos, logos). Só a posição acompanha."/>
                  <Button Content="Desmarcar" Click="Desmarcar_Click"/>
                </UniformGrid>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================================ APLICAR -->
      <TabItem Header="Aplicar">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,4,2,4">
            <GroupBox Header="Espelhar matrizes nos tamanhos">
              <StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Copia tudo o que está na MATRIZ (arte do PowerClip e objetos por cima dela) para todos os moldes da mesma parte, no próprio lugar, ajustando ao tamanho de cada um. Textos e objetos FIXO mantêm o tamanho; só a posição acompanha." />
                <TextBlock Text="Partes" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="AplicarParte"/>
                <CheckBox x:Name="AplicarSoSelecao" Content="Somente nos moldes selecionados"/>
                <CheckBox x:Name="AplicarSubst" Content="Substituir a arte que já existe nos moldes" IsChecked="True"/>
                <Button Content="APLICAR MATRIZES" Style="{StaticResource Primary}" Click="Aplicar_Click" Margin="2,8,2,2"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Escala da arte">
              <StackPanel>
                <ComboBox x:Name="AplicarEscala">
                  <ComboBoxItem Content="Esticar (acompanha largura e altura)"/>
                  <ComboBoxItem Content="Uniforme cobrindo o molde"/>
                  <ComboBoxItem Content="Uniforme pela largura"/>
                </ComboBox>
                <TextBlock Style="{StaticResource Hint}" Text="Vale também para a montagem do pedido."/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================================ PEDIDO -->
      <TabItem Header="Pedido">
        <DockPanel Margin="0,4,2,4">
          <StackPanel DockPanel.Dock="Top">
            <Button Content="☁  Pedidos online (escolher pedido)" Style="{StaticResource Primary}" Click="PedidosOnline_Click" Margin="2,2,2,6"/>
            <TextBlock Text="Pedido" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="Pedido" ToolTip="Vai no ID impresso e no nome dos arquivos"/>
            <UniformGrid Columns="2" Margin="0,4,0,0">
              <Button Content="Importar planilha..." Click="Planilha_Click"/>
              <Button Content="Colar do Excel" Click="Colar_Click"/>
              <Button Content="Baixar modelo" Click="Modelo_Click" ToolTip="Planilha com as colunas Tipo, Nome, Número, Adicional, Tam. Camiseta, Tam. Calção, Quantidade"/>
              <Button Content="Limpar lista" Click="LimparLista_Click"/>
            </UniformGrid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Tamanhos de:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
              <RadioButton x:Name="UsarCamiseta" Grid.Column="1" Content="Camiseta" IsChecked="True" Foreground="{StaticResource Fg}" Margin="6,0" VerticalAlignment="Center" Checked="UsarTamanho_Checked"/>
              <RadioButton x:Name="UsarCalcao" Grid.Column="2" Content="Calção" Foreground="{StaticResource Fg}" Margin="6,0" VerticalAlignment="Center" Checked="UsarTamanho_Checked"/>
              <ComboBox x:Name="FiltroTipo" Grid.Column="3" ToolTip="Tipo (Linha, Goleiro...)" SelectionChanged="FiltroTipo_SelectionChanged"/>
            </Grid>
            <TextBlock x:Name="ColunasInfo" Style="{StaticResource Hint}"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ResumoPedido" Style="{StaticResource Hint}"/>
            <Button Content="MONTAR PEDIDO" Style="{StaticResource Primary}" Click="Montar_Click"/>
            <TextBlock Style="{StaticResource Hint}" Text="As peças com nome/número são criadas à direita do desenho, uma linha por uniforme."/>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="SelParte" IsEditable="True" ToolTip="Parte (nº ou apelido). Vazio = todas"/>
              <ComboBox x:Name="SelTamanho" Grid.Column="1" IsEditable="True" ToolTip="Tamanho. Vazio = todos"/>
              <Button Grid.Column="2" Content="Selecionar peças" Click="SelecionarPecas_Click"/>
            </Grid>
          </StackPanel>
          <DataGrid x:Name="Grade" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                    HeadersVisibility="Column" MinHeight="140" Margin="2,4" RowHeaderWidth="0"
                    CellEditEnding="Grade_CellEditEnding">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="50"/>
              <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
              <DataGridTextColumn Header="Nº" Binding="{Binding Numero}" Width="32"/>
              <DataGridTextColumn Header="Adic." Binding="{Binding Adicional}" Width="45"/>
              <DataGridTextColumn Header="Cam." Binding="{Binding TamanhoCamiseta}" Width="38"/>
              <DataGridTextColumn Header="Calç." Binding="{Binding TamanhoCalcao}" Width="38"/>
              <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="32"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ============================================================ FERRAMENTAS -->
      <TabItem Header="Ferramentas">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,4,2,4">
            <GroupBox Header="Transferir arte">
              <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="1) Selecione o molde com a arte → Origem.  2) Selecione os destinos → Transferir." />
                <UniformGrid Columns="2">
                  <Button Content="Definir origem" Click="Origem_Click"/>
                  <Button Content="Transferir" Click="Transferir_Click"/>
                </UniformGrid>
                <CheckBox x:Name="TransfTudo" Content="Levar também objetos soltos sobre o molde"/>
                <CheckBox x:Name="TransfSubst" Content="Substituir conteúdo existente" IsChecked="True"/>
                <TextBlock x:Name="OrigemInfo" Style="{StaticResource Hint}" Text="Origem: (nenhuma)"/>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Criar cópias de peças montadas">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBox x:Name="NumCopias" Text="1" HorizontalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Criar cópias (novo sequencial)" Click="Copias_Click"/>
              </Grid>
            </GroupBox>

            <GroupBox Header="Alinhamento e rotação">
              <UniformGrid Columns="2">
                <Button Content="⇋  Espelhar horiz." Tag="H" Click="Espelhar_Click"/>
                <Button Content="⇵  Espelhar vert." Tag="V" Click="Espelhar_Click"/>
                <Button Content="↻  Girar 180°" Tag="180" Click="Girar_Click"/>
                <Button Content="↻  Girar 90°" Tag="90" Click="Girar_Click"/>
                <Button Content="Empilhar ao centro" Click="EmpilharCentro_Click"/>
                <Button Content="Empilhar horizontal" Click="EmpilharHorizontal_Click"/>
              </UniformGrid>
            </GroupBox>

            <GroupBox Header="Texto e contorno">
              <StackPanel>
                <Button Content="Converter textos em curvas" Click="TextoCurvas_Click"/>
                <CheckBox x:Name="CurvasDentro" Content="Incluir textos dentro de PowerClips" IsChecked="True"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="ContornoMm" ToolTip="Espessura em mm (0 = sem contorno)"/>
                  <ComboBox x:Name="ContornoCor" Grid.Column="1" SelectedIndex="0">
                    <ComboBoxItem Content="Preto (K100)"/>
                    <ComboBoxItem Content="Cinza (K70)"/>
                    <ComboBoxItem Content="Vermelho"/>
                    <ComboBoxItem Content="Branco"/>
                  </ComboBox>
                  <Button Grid.Column="2" Content="Aplicar" Click="Contorno_Click"/>
                </Grid>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Substituir cor">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Content="Pegar cor original" Click="PegarCor_Click" ToolTip="Usa o preenchimento do objeto selecionado"/>
                  <TextBlock x:Name="CorOriginalInfo" Grid.Column="1" VerticalAlignment="Center" Margin="6,0" Text="(nenhuma)"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Label Content="Nova CMYK"/>
                  <TextBox x:Name="NovaC" Grid.Column="1" Text="0"/>
                  <TextBox x:Name="NovaM" Grid.Column="2" Text="0"/>
                  <TextBox x:Name="NovaY" Grid.Column="3" Text="0"/>
                  <TextBox x:Name="NovaK" Grid.Column="4" Text="100"/>
                </Grid>
                <WrapPanel>
                  <CheckBox x:Name="CorPreench" Content="Preenchimentos" IsChecked="True" Margin="2,4,8,4"/>
                  <CheckBox x:Name="CorContornos" Content="Contornos" IsChecked="True" Margin="2,4,8,4"/>
                  <CheckBox x:Name="CorDentro" Content="Dentro de PowerClips" IsChecked="True"/>
                </WrapPanel>
                <Button Content="Substituir na seleção" Click="SubstituirCor_Click"/>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Limpar e relatório">
              <StackPanel>
                <CheckBox x:Name="LimparFill" Content="Remover também o preenchimento" IsChecked="True"/>
                <UniformGrid Columns="2">
                  <Button Content="Limpar moldes" Click="Limpar_Click"/>
                  <Button Content="Relatório de partes" Click="Relatorio_Click"/>
                </UniformGrid>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================================ ENCAIXE -->
      <TabItem Header="Encaixe">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,4,2,4">
            <GroupBox Header="Encaixe sobre outro">
              <StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Importe o encaixe do seu software de nesting, selecione as formas-base junto com as peças montadas e clique em Encaixar. Cada peça vai para a forma equivalente, com rotação (0/90/180/270°) e espelhamento detectados." />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <Label Content="Tolerância de tamanho (cm)"/>
                  <TextBox x:Name="EncTol" Grid.Column="1"/>
                  <Label Grid.Row="1" Content="Similaridade de nós (%, 0 = ignorar)"/>
                  <TextBox x:Name="EncSim" Grid.Row="1" Grid.Column="1"/>
                </Grid>
                <CheckBox x:Name="EncEspelhar" Content="Permitir peças espelhadas (mangas, laterais)"/>
                <CheckBox x:Name="EncCopiar" Content="Copiar peças quando o encaixe pedir mais"/>
                <CheckBox x:Name="EncApagar" Content="Apagar formas-base encaixadas"/>
                <Button Content="ENCAIXAR SELEÇÃO" Style="{StaticResource Primary}" Click="Encaixar_Click" Margin="2,8,2,2"/>
                <TextBlock Style="{StaticResource Hint}" Text="Formas-base sem par ficam com contorno vermelho." />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================================ EXPORTAR -->
      <TabItem Header="Exportar">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,4,2,4">
            <GroupBox Header="Arquivo">
              <StackPanel>
                <UniformGrid Columns="3">
                  <StackPanel>
                    <TextBlock Text="Formato" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ExpFormato">
                      <ComboBoxItem Content="JPG"/><ComboBoxItem Content="PDF"/><ComboBoxItem Content="TIF"/><ComboBoxItem Content="PNG"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Cor" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ExpCor">
                      <ComboBoxItem Content="CMYK"/><ComboBoxItem Content="RGB"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="DPI" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ExpDpi"/>
                  </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="2">
                  <StackPanel>
                    <TextBlock Text="Tecido" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ExpTecido"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="PDF: compressão" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ExpPdfComp">
                      <ComboBoxItem Content="JPEG"/><ComboBoxItem Content="LZW"/>
                    </ComboBox>
                  </StackPanel>
                </UniformGrid>
                <TextBlock Text="Pasta" Style="{StaticResource FieldLabel}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="ExpPasta"/>
                  <Button Grid.Column="1" Content="..." Click="EscolherPasta_Click"/>
                </Grid>
                <TextBlock Text="Nome base (vazio = arquivo .cdr + pedido)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ExpNome"/>
                <CheckBox x:Name="ExpUmPorObjeto" Content="Um arquivo por objeto selecionado" IsChecked="True"/>
                <CheckBox x:Name="ExpRelatorio" Content="Gerar relatório (.txt) de partes"/>
                <Button Content="EXPORTAR SELEÇÃO" Style="{StaticResource Primary}" Click="Exportar_Click" Margin="2,8,2,2"/>
                <TextBlock Style="{StaticResource Hint}" Text="Segure ESC para cancelar uma exportação longa." />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================================ CONFIG -->
      <TabItem Header="Config">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,4,2,4">
            <GroupBox Header="Tamanhos (um por linha, do menor ao maior)">
              <StackPanel>
                <TextBox x:Name="CfgTamanhos" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                <CheckBox x:Name="CfgRotulo" Content="Criar etiqueta vermelha com o nome abaixo de cada molde"/>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Planilha (letra da coluna)">
              <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Se a 1ª linha tiver os títulos (Tipo, Nome, Número...), as colunas são achadas sozinhas. Estas letras valem quando não há títulos."/>
                <UniformGrid Columns="7">
                  <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}"/><TextBlock Text="Nome" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="Nº" Style="{StaticResource FieldLabel}"/><TextBlock Text="Adic." Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="Cam." Style="{StaticResource FieldLabel}"/><TextBlock Text="Calç." Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="Qtd" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="CfgColTipo"/><TextBox x:Name="CfgColNome"/><TextBox x:Name="CfgColNum"/>
                  <TextBox x:Name="CfgColAd"/><TextBox x:Name="CfgColTam"/><TextBox x:Name="CfgColCalcao"/><TextBox x:Name="CfgColQtd"/>
                </UniformGrid>
                <CheckBox x:Name="CfgCabecalho" Content="Primeira linha é cabeçalho"/>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Montagem do pedido">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <Label Content="Largura máx. do NOME (% do molde)"/><TextBox x:Name="CfgLargNome" Grid.Column="1"/>
                  <Label Grid.Row="1" Content="Largura máx. do Nº (% do molde)"/><TextBox x:Name="CfgLargNum" Grid.Row="1" Grid.Column="1"/>
                  <Label Grid.Row="2" Content="Largura máx. do ADIC. (% do molde)"/><TextBox x:Name="CfgLargAd" Grid.Row="2" Grid.Column="1"/>
                  <Label Grid.Row="3" Content="Espaço entre peças (cm)"/><TextBox x:Name="CfgEspaco" Grid.Row="3" Grid.Column="1"/>
                  <Label Grid.Row="4" Content="Fonte do indicador (pt)"/><TextBox x:Name="CfgFonteInd" Grid.Row="4" Grid.Column="1"/>
                  <Label Grid.Row="5" Content="Folga do texto até a borda da peça (%)"/><TextBox x:Name="CfgMargem" Grid.Row="5" Grid.Column="1"/>
                </Grid>
                <CheckBox x:Name="CfgNomeMaius" Content="NOME em maiúsculas"/>
                <CheckBox x:Name="CfgAdMaius" Content="ADICIONAL em maiúsculas"/>
                <CheckBox x:Name="CfgAjustarGab" Content="Aumentar texto para preencher o gabarito"/>
                <CheckBox x:Name="CfgIndicador" Content="Criar indicador acima de cada linha"/>
                <CheckBox x:Name="CfgAgrupar" Content="Agrupar cada linha após montar"/>
                <CheckBox x:Name="CfgBranco" Content="Matriz sem cor: preencher peças de branco"/>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="ID impresso na peça">
              <StackPanel>
                <CheckBox x:Name="CfgGerarId" Content="Gerar ID"/>
                <WrapPanel>
                  <CheckBox x:Name="CfgIdPed" Content="Pedido" Margin="2,4,10,4"/>
                  <CheckBox x:Name="CfgIdSeq" Content="Sequencial" Margin="2,4,10,4"/>
                  <CheckBox x:Name="CfgIdTam" Content="Tamanho" Margin="2,4,10,4"/>
                  <CheckBox x:Name="CfgIdParte" Content="Nº parte" Margin="2,4,10,4"/>
                  <CheckBox x:Name="CfgIdApelido" Content="Apelido"/>
                </WrapPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                  <Label Content="Fonte"/><TextBox x:Name="CfgIdFonte" Grid.Column="1"/>
                  <Label Grid.Column="2" Content="pt"/><TextBox x:Name="CfgIdTam2" Grid.Column="3"/>
                </Grid>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Pedidos online (Supabase)">
              <StackPanel>
                <TextBlock Text="Endereço do projeto (https://xxxx.supabase.co)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="CfgSupaUrl"/>
                <TextBlock Text="Chave SECRETA (service_role / sb_secret_...)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="CfgSupaChave"/>
                <TextBlock Text="Endereço do formulário web (onde está o index.html)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="CfgLinkForm"/>
                <TextBlock Style="{StaticResource Hint}" Text="A chave secreta fica só neste computador. Nunca coloque ela no formulário web."/>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Tecidos (nome;largura cm, um por linha)">
              <StackPanel>
                <TextBox x:Name="CfgTecidos" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                <TextBlock Text="Pasta do relatório" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="CfgPastaRel"/>
              </StackPanel>
            </GroupBox>

            <Button Content="SALVAR CONFIGURAÇÕES" Style="{StaticResource Primary}" Click="SalvarConfig_Click"/>
            <UniformGrid Columns="2">
              <Button Content="Restaurar padrão" Click="RestaurarConfig_Click"/>
              <Button Content="Sobre" Click="Sobre_Click"/>
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
