<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <CorelDir Condition="'$(CorelDir)'==''">C:\Program Files\Corel\CorelDRAW Graphics Suite\27\Programs64</CorelDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AhcMoldes\AhcMoldes.csproj" />
    <Reference Include="Corel.Interop.VGCore">
      <HintPath>$(CorelDir)\Assemblies\Corel.Interop.VGCore.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
