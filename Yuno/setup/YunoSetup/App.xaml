<Application x:Class="YunoSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#FF1E1F21"/>
    <SolidColorBrush x:Key="Card" Color="#FF2A2B2E"/>
    <SolidColorBrush x:Key="Line" Color="#FF3A3C40"/>
    <SolidColorBrush x:Key="Fg" Color="#FFF2F3F5"/>
    <SolidColorBrush x:Key="FgDim" Color="#FF9AA0A8"/>
    <SolidColorBrush x:Key="Accent" Color="#FF2ECC71"/>
    <LinearGradientBrush x:Key="Brand" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF4ADE80" Offset="0"/>
      <GradientStop Color="#FF22B06A" Offset="0.45"/>
      <GradientStop Color="#FF0E6E4A" Offset="0.8"/>
      <GradientStop Color="#FF083428" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="28,11"/>
    </Style>
  </Application.Resources>
</Application>
