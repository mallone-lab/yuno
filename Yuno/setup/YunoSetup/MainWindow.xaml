<Window x:Class="YunoSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YUNO · Instalador" Width="760" Height="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="Segoe UI" Icon="yuno-icone.png">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- lado da marca (como os slides do template) -->
    <Border Background="{StaticResource Brand}">
      <Grid Margin="30">
        <StackPanel VerticalAlignment="Top">
          <Image Source="yuno-icone.png" Width="64" Height="64" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="0,40,0,0">
          <TextBlock Text="YUNO" Foreground="White" FontSize="46" FontWeight="Bold"/>
          <TextBlock Text="moldes e uniformes sublimados" Foreground="#E6FFFFFF" FontSize="14" Margin="2,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="VersaoTxt" VerticalAlignment="Bottom" Foreground="#B3FFFFFF" FontSize="12" Text="versão"/>
      </Grid>
    </Border>

    <!-- lado da ação -->
    <Grid x:Name="WelcomePage" Grid.Column="1" Margin="34,30,34,26">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Bem-vindo ao YUNO" Foreground="{StaticResource Fg}" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="O que você deseja fazer?" Foreground="{StaticResource FgDim}" FontSize="14" Margin="0,10,0,30"/>
        <Button Style="{StaticResource BtnPrimary}" Click="EscolherInstalar_Click" HorizontalContentAlignment="Left">
          <StackPanel Width="290">
            <TextBlock Text="Instalar YUNO" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Adicionar ou atualizar o YUNO no seu CorelDRAW." FontSize="12" FontWeight="Normal" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Btn}" Click="EscolherRemover_Click" Margin="0,14,0,0">
          <StackPanel Width="290">
            <TextBlock Text="Remover YUNO" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Desinstalar de uma versão do CorelDRAW. Suas configurações serão mantidas." Foreground="{StaticResource FgDim}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <Button Content="Sair" Style="{StaticResource Btn}" Click="Fechar_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
    </Grid>
    <Grid x:Name="ActionPage" Grid.Column="1" Margin="34,30,34,26" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock x:Name="Titulo" Text="Instalar no CorelDRAW" Foreground="{StaticResource Fg}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="Sub" Foreground="{StaticResource FgDim}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Um clique e a barra YUNO aparece no topo do CorelDRAW, com tudo pronto para usar."/>
      </StackPanel>

      <Border Grid.Row="1" Margin="0,22,0,0" Padding="14,12" CornerRadius="10" Background="{StaticResource Card}"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="CorelDRAW" Foreground="{StaticResource FgDim}" FontSize="12"/>
          <ComboBox x:Name="CorelLista" Style="{StaticResource CorelSelect}" Margin="0,8,0,0" SelectionChanged="Corel_SelectionChanged"/>
          <TextBlock x:Name="CorelAviso" Foreground="#FFF5B041" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
          <StackPanel x:Name="SerialPanel" Margin="0,12,0,0">
            <TextBlock Text="Serial" Foreground="{StaticResource Fg}" FontSize="12"/>
            <PasswordBox x:Name="SerialInput" Style="{StaticResource SerialField}" MaxLength="128" Margin="0,8,0,0"/>
            <TextBlock Text="Cole o serial recebido para autorizar a instalação." Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Margin="0,14,0,14" Padding="14,10" CornerRadius="10" Background="#FF17181A">
        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="Log" Foreground="{StaticResource FgDim}" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>
        </ScrollViewer>
      </Border>

      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="BtnFechar" Content="Voltar" Style="{StaticResource Btn}" Click="Voltar_Click"/>
        <Button x:Name="BtnAcao" Grid.Column="2" Content="Instalar" Style="{StaticResource BtnPrimary}" Click="Acao_Click"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
