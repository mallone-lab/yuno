<Window x:Class="YunoSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YUNO · Instalador" Width="760" Height="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="Segoe UI" Icon="yuno-icone.png">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- lado da marca (como os slides do template) -->
    <Border Background="{StaticResource Brand}">
      <Grid Margin="30">
        <StackPanel VerticalAlignment="Top">
          <Image Source="yuno-icone.png" Width="64" Height="64" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="0,40,0,0">
          <TextBlock Text="YUNO" Foreground="White" FontSize="46" FontWeight="Bold"/>
          <TextBlock Text="moldes e uniformes sublimados" Foreground="#E6FFFFFF" FontSize="14" Margin="2,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="VersaoTxt" VerticalAlignment="Bottom" Foreground="#B3FFFFFF" FontSize="12" Text="versão"/>
      </Grid>
    </Border>

    <!-- lado da ação -->
    <Grid Grid.Column="1" Margin="34,30,34,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock x:Name="Titulo" Text="Instalar no CorelDRAW" Foreground="{StaticResource Fg}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="Sub" Foreground="{StaticResource FgDim}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Um clique e a barra YUNO aparece no topo do CorelDRAW, com tudo pronto para usar."/>
      </StackPanel>

      <Border Grid.Row="1" Margin="0,22,0,0" Padding="14,12" CornerRadius="10" Background="{StaticResource Card}"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="CorelDRAW encontrado" Foreground="{StaticResource FgDim}" FontSize="11"/>
          <TextBlock x:Name="CorelTxt" Foreground="{StaticResource Fg}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" Text="procurando..."/>
          <TextBlock x:Name="CorelAviso" Foreground="#FFF5B041" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Margin="0,14,0,14" Padding="14,10" CornerRadius="10" Background="#FF17181A">
        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="Log" Foreground="{StaticResource FgDim}" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>
        </ScrollViewer>
      </Border>

      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="BtnFechar" Content="Fechar" Style="{StaticResource Btn}" Click="Fechar_Click"/>
        <Button x:Name="BtnAcao" Grid.Column="2" Content="Instalar" Style="{StaticResource BtnPrimary}" Click="Acao_Click"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
